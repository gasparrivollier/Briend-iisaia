# Production entry point: HTTPS (automatic certificates), the built Vue app and the /api proxy.
# PULSO_DOMAIN is the public host name (e.g. pulso.example.com); "localhost" uses Caddy's local CA.
{$PULSO_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# Bulk uploads (xlsx/csv) may exceed the 1MB JSON limit; the API enforces the exact file size.
	@upload path /api/carga-masiva/*
	handle @upload {
		request_body {
			max_size 6MB
		}
		reverse_proxy api:5000
	}

	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:5000
	}

	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header X-Frame-Options DENY
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control no-cache
		# History-mode SPA: unknown paths serve index.html; the Vue router decides.
		try_files {path} /index.html
		file_server
	}
}
