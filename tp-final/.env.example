# Copy to .env (never commit it) and fill in the values.
POSTGRES_PASSWORD=
# Public host name; Caddy obtains the HTTPS certificate automatically (ports 80/443 must reach it).
PULSO_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
API_WORKERS=2
BACKUP_DAYS=14
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=notificaciones@tu-dominio.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
