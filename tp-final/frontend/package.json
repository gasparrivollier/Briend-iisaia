{
  "name": "pulso-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "TZ=America/Argentina/Buenos_Aires vitest run",
    "test:e2e": "playwright test",
    "gen:api": "uv run --project ../backend python -m pulso.openapi > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.103.2",
    "@vuepic/vue-datepicker": "14.0.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "frappe-gantt": "1.2.2",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
